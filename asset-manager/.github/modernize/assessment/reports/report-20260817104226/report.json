        },
        {
          "url": "https://learn.microsoft.com/azure/postgresql/single-server/concepts-backup",
          "title": "Backup and restore in Azure Database for PostgreSQL"
        }
      ],
      "labels": [
        "target=azure-appservice",
        "target=azure-aks",
        "target=azure-container-apps",
        "source",
